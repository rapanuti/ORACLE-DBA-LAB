# =====================================================================
#  Oracle DBA Lab - variables de entorno
#  Copia este archivo a .env  (cp .env.example .env)  y ajusta valores.
#  NUNCA subas tu .env al repositorio (ya está en .gitignore).
# =====================================================================

# --- Imagen de Oracle local --------------------------------------------
# gvenzl/oracle-free publica builds nativos amd64 (Ubuntu, Mac Intel) y
# arm64 (Mac Apple Silicon M1-M4). "23-slim-faststart" arranca en segundos.
ORACLE_IMAGE=gvenzl/oracle-free:23-slim-faststart

# Contraseña de SYS / SYSTEM (solo se usa para funciones administrativas)
ORACLE_PASSWORD=OracleLab_2024

# --- Esquema educativo (perfil "lab": lectura/escritura) -----------------
LAB_DB_HOST=oracle            # nombre del servicio en docker compose
LAB_DB_PORT=1521
LAB_DB_SERVICE=FREEPDB1
LAB_DB_USER=LAB
LAB_DB_PASSWORD=LabPass_2024
# Crea el esquema de citas médicas automáticamente si está vacío
LAB_AUTO_SEED=true
# Permite el botón "Restaurar estado inicial" (desactívalo en servidores remotos compartidos)
LAB_ALLOW_RESET=true

# --- Funciones administrativas (perfil "admin", solo lectura de vistas DBA/V$) -
ADMIN_ENABLED=true
ADMIN_DB_USER=SYSTEM
# Si se deja vacío se usa ORACLE_PASSWORD
ADMIN_DB_PASSWORD=

# --- Instancia Oracle remota opcional (perfil "external") ----------------
# Formato DSN: host:puerto/servicio   (ej. db.miempresa.com:1521/ORCLPDB1)
# Por defecto es SOLO LECTURA: únicamente se permiten consultas SELECT/WITH.
EXTERNAL_DB_DSN=
EXTERNAL_DB_USER=
EXTERNAL_DB_PASSWORD=
EXTERNAL_DB_ALLOW_WRITE=false

# --- Aplicación ----------------------------------------------------------
MAX_ROWS=500
QUERY_TIMEOUT_SECONDS=60
SESSION_IDLE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Puertos publicados en tu máquina ------------------------------------
ORACLE_PORT=1521
BACKEND_PORT=8000
FRONTEND_PORT=8080
